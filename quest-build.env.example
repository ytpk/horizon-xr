# Copy to .quest-build.env in the repository root. Use Linux/WSL paths.
# This is shell syntax; quote paths with spaces. Never add this local file to Git.
export ANDROID_HOME="$HOME/Android/Sdk"
# export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/29.0.14206865"
# export JAVA_HOME="$HOME/tools/jdk-25"
# export PATH="$JAVA_HOME/bin:$HOME/.cargo/bin:$PATH"

# Your installed, launched-once Minecraft Java Edition 26.3 and its server jar.
# Under WSL, Windows files are accessible through /mnt/c/... .
# export HORIZON_MINECRAFT_DIR="/mnt/c/Users/YOUR_NAME/AppData/Roaming/.minecraft"
# export HORIZON_SERVER_JAR="$HOME/Downloads/server-26.3.jar"

# Only your own Azure application client ID with the required Minecraft approval.
# This is not a personal access token, client secret or Microsoft account password.
# Leaving this unset builds an APK with Microsoft sign-in unavailable.
# export HORIZON_MSA_CLIENT_ID="YOUR_OWN_APPLICATION_CLIENT_ID"

# Optional: build output directory and Cargo profile (quest is the default).
# export OUT="$HOME/horizon-quest-build"
# export PROFILE=quest
